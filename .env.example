# Copy to .env and fill in. Never commit .env.
# Switching environment (local -> home-server staging -> production) = changing these values, not code.

APP_ENV=local
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000
COOKIE_DOMAIN=localhost
API_PORT=4000

# Postgres 16 + pgvector (infra/docker-compose.dev.yml)
POSTGRES_USER=loopedu
POSTGRES_PASSWORD=change-me
POSTGRES_DB=loopedu
DATABASE_URL=postgresql://loopedu:change-me@localhost:5432/loopedu
DATABASE_MIGRATION_URL=postgresql://loopedu:change-me@localhost:5432/loopedu

# Object storage: Cloudflare R2 through its S3 API, one private bucket per environment
# (loopedu-voice-dev / -staging / -prod). Keys come from an R2 API token scoped to that bucket.
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=loopedu-voice-dev
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true

# Auth (RS256 JWT signing keys, PEM; generate per environment, keep "\n" for line breaks on one line):
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt.key && openssl rsa -pubout -in jwt.key -out jwt.pub
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
# Google sign-in: OAuth "Web application" client ID (Google Cloud Console > Credentials). Add the web origin under
# "Authorized JavaScript origins". The API only verifies ID tokens, so no client secret is needed.
GOOGLE_CLIENT_ID=
# Number of reverse proxies in front of the API (1 behind Cloudflare Tunnel); empty = none. Needed for per-IP rate limits.
TRUST_PROXY=

# Email (Mailpit locally: SMTP on 1025, inbox UI on http://localhost:8025)
# Staging/production: real SMTP, e.g. smtps://USER:PASS@smtp.provider.com:465, sender domain with SPF/DKIM
EMAIL_FROM=LoopEdu <no-reply@loopedu.local>
SMTP_URL=smtp://localhost:1025

# AI providers (use separate low-limit keys for staging)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southeastasia
OPENAI_API_KEY=
AI_MONTHLY_BUDGET_USD=20

# Staging only (infra/docker-compose.staging.yml): token of the Cloudflare Tunnel
CLOUDFLARE_TUNNEL_TOKEN=

SENTRY_DSN=

# Web (Next.js) — public values inlined at build time; set them as build args for the Docker image.
# Copy to apps/web/.env.local for local dev. NEXT_PUBLIC_GOOGLE_CLIENT_ID is the same client ID as GOOGLE_CLIENT_ID.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
