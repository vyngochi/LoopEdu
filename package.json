{
  "name": "loopedu",
  "private": true,
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @loopedu/shared build && pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "db:check": "pnpm --filter @loopedu/api db:check",
    "infra:up": "docker compose -f infra/docker-compose.dev.yml --env-file .env up -d",
    "infra:down": "docker compose -f infra/docker-compose.dev.yml --env-file .env down"
  }
}
